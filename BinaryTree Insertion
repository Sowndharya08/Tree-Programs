import java.util.*;

class Node{
    int val;
    Node left,right;
   Node(){}
    Node(int val){
        this.val=val;
        left=right=null;
    }
}
class BT{
    public static Node insert(int a[]){
        if(a.length==0)
        return new Node();
        Node root=new Node(a[0]);
        Queue<Node> q=new LinkedList<>();
        q.add(root);
        int i=1;
        while(!q.isEmpty()){
            Node curr=q.poll();
            if(i<a.length && a[i]!=-1){
                curr.left=new Node(a[i]);
                q.add(curr.left);
            }
            i++;
           if(i<a.length && a[i]!=-1){
                curr.right=new Node(a[i]);
                q.add(curr.right);
            }
            i++;
        }
        return root;
}


public static void preorder(Node root){
    if(root!=null){
        System.out.print(root.val+" ");
        preorder(root.left);
        preorder(root.right);
    }
}
}
class Main{
    public static void main(String[] args){
        BT b=new BT();
        int [] arr={1,7,3,6,5};
        Node root=b.insert(arr);
        b.preorder(root);
        
        
    }
}
